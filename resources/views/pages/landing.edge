@layouts.main({ title: 'Jelajahi Sayembara — KreasiHub' })
<nav class="navbar">
<a href="/" class="logo">Sayembara</a>
<div class="nav-links">
<a href="/" class="nav-link active">Jelajahi</a>
<a href="/admin/dashboard" class="nav-link">Dashboard Admin</a>
</div>
<div class="nav-actions">
<a href="/admin/dashboard" class="btn btn-g">Kelola Platform</a>
</div>
</nav>

<div class="hero">
<p class="hero-label">Platform Kompetisi Kreatif</p>
<h1>Tunjukkan<br><em>karyamu.</em></h1>
<p>Ikuti sayembara desain, submit karyamu, dan biarkan rumus komparasi vote menentukan yang terbaik.</p>
</div>

<div class="cards-section">
<div class="section-header">
<p class="section-title">Sayembara aktif</p>
</div>
<div class="cards">
@each(contest in contests)
<div class="card" onclick="window.location.href='/sayembara/{{ contest.id }}'">
<div class="card-img" style="padding: 0; overflow: hidden; position: relative;">
<img src="{{ contest.imageUrl || 'https://images.unsplash.com/photo-1542204165-65bf26472b9b?q=80&w=800' }}" style="width: 100%; height: 100%; object-fit: cover;" alt="Banner Sayembara">
<span style="position: absolute; top: 12px; left: 12px;">
<span class="badge {{ contest.status === 'active' ? 'badge-aktif' : 'badge-selesai' }}">
{{ contest.status === 'active' ? 'Aktif' : 'Selesai' }}
</span>
</span>
</div>
<div class="card-body">
<p class="card-cat">{{ contest.category }} &bull; Oleh {{ contest.organizer || 'NN' }}</p>
<p class="card-title">{{ contest.title }}</p>
<p class="card-desc">{{ contest.description }}</p>
<div class="card-meta">
<div>
<p class="card-meta-text" style="color: var(--muted)">Deadline</p>
<p class="card-meta-text" style="font-weight: 500; color: var(--ink)">
{{ contest.deadline.toFormat('dd LLL yyyy') }}
</p>
</div>
<div>
<p class="card-meta-text" style="color: var(--muted); text-align: right">Karya</p>
<p class="card-meta-text" style="font-weight: 500; color: var(--ink); text-align: right">
{{ contest.submissions.length }} Peserta
</p>
</div>
</div>
</div>
</div>
@else
<div style="grid-column: 1/-1; text-align: center; padding: 48px; color: var(--muted);">
Belum ada sayembara aktif. Buka Dashboard Admin untuk menambahkan lomba pertama!
</div>
@endeach
</div>
</div>
@end