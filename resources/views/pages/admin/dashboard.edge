@layouts.main({ title: 'Dashboard Admin Kelola — KreasiHub' })
<nav class="navbar">
<a href="/" class="logo">Sayembara</a>
<div class="nav-links">
<a href="/" class="nav-link">Jelajahi</a>
<a href="/admin/dashboard" class="nav-link active">Dashboard Admin</a>
</div>
<div class="nav-actions">
<form action="/logout" method="POST" style="margin: 0;">
{{ csrfField() }}
<button type="submit" class="btn btn-o">Logout</button>
</form>
<a href="/" class="btn btn-o">Lihat Sisi Publik</a>
</div>
</nav>

<div class="admin-layout">
<aside class="sidebar">
<div class="side-item active">⚙ Kelola Sayembara</div>
</aside>

<main class="admin-main">
<h1 class="form-title" style="font-size: 2.2rem; margin-bottom: 4px;">Pusat Kontrol Kontes</h1>
<p style="font-size: 0.9rem; color: var(--muted); margin-bottom: 32px;">Pantau statistik global dan kelola semua lomba.</p>

<div class="bento-info" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 32px;">
<div class="bento-card">
<p class="bento-label">Total Lomba</p>
<p class="bento-val" style="color: var(--primary);">{{ stats.contests }}</p>
</div>
<div class="bento-card">
<p class="bento-label">Total Karya Tersubmit</p>
<p class="bento-val" style="color: var(--primary);">{{ stats.submissions }}</p>
</div>
<div class="bento-card">
<p class="bento-label">Total Aktivitas Vote</p>
<p class="bento-val" style="color: var(--primary);">{{ stats.votes }}</p>
</div>
</div>

<div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 32px; align-items: start;">
<div>
<h2 class="section-title">Daftar Sayembara Terdaftar</h2>
<div class="table-container">
<table class="table">
<thead>
<tr>
<th>Judul Kompetisi</th>
<th>Kategori & Peserta</th>
<th>Bobot (P/J)</th>
<th>Aksi</th>
</tr>
</thead>
<tbody>
@each(contest in contests)
<tr>
<td style="font-weight: 600; color: var(--black);">{{ contest.title }}</td>
<td>
  <span class="badge badge-aktif" style="background: var(--surface); color: var(--primary); margin-bottom: 4px; display: inline-block;">{{ contest.category }}</span><br>
  <span style="font-size: 0.8rem; color: var(--ink);">By {{ contest.organizer || 'NN' }}</span><br>
  <span style="font-size: 0.8rem; color: var(--muted);">{{ contest.submissions.length }} Pendaftar</span>
</td>
<td style="font-family: monospace; font-weight: 500; font-size: 0.9rem;">{{ contest.weightPublic }}% / {{ contest.weightJury }}%</td>
<td>
<div style="display: flex; gap: 8px; align-items: center;">
<a href="/admin/sayembaras/{{ contest.id }}" class="btn btn-p" style="padding: 6px 12px; font-size: 0.75rem;">Detail & Kelola</a>
<form action="/admin/sayembaras/{{ contest.id }}?_method=DELETE" method="POST" onsubmit="return confirm('Apakah kamu yakin ingin menghapus kompetisi ini? Seluruh data pendaftar juga akan hilang.')">
{{ csrfField() }}
<button type="submit" style="background: var(--surface); border: 1px solid var(--border); color: #ff5f56; padding: 6px 12px; border-radius: 8px; font-size: 0.75rem; cursor: pointer; font-weight: 600;">Hapus</button>
</form>
</div>
</td>
</tr>
@else
<tr>
<td colspan="4" style="text-align: center; color: var(--muted); padding: 24px;">Belum ada sayembara yang dibuat.</td>
</tr>
@endeach
</tbody>
</table>
</div>
</div>

<div style="background: var(--surface); padding: 24px; border-radius: 12px; border: 1px solid var(--border);">
<h2 class="section-title" style="margin-bottom: 16px;">Buat Sayembara Baru</h2>
<form action="/admin/sayembaras" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
{{ csrfField() }}
<div class="form-group">
<label class="form-label">Nama Sayembara</label>
<input type="text" name="title" placeholder="Misal: Lomba UI/UX Nasional 2026" class="form-input" style="background: var(--white);" required>
</div>

<div class="form-group">
<label class="form-label">Kategori</label>
<select name="category" class="form-input" style="background: var(--white); cursor: pointer;" required>
  <option value="" disabled selected>Pilih kategori...</option>
  <option value="Poster">Desain Poster</option>
  <option value="Web Design">Web / UI/UX Design</option>
  <option value="Logo">Desain Logo / Maskot</option>
</select>
<span style="font-size: 0.75rem; color: var(--muted); margin-top: 4px; display: inline-block;">Banner sayembara akan menyesuaikan dengan kategori secara otomatis.</span>
</div>

<div class="form-group">
<label class="form-label">Penyelenggara</label>
<input type="text" name="organizer" placeholder="Misal: Himpunan Mahasiswa Informatika" class="form-input" style="background: var(--white);" required>
</div>

<div class="form-group">
<label class="form-label">Deskripsi & Aturan Main</label>
<textarea name="description" placeholder="Tuliskan regulasi sayembara di sini..." class="form-input" style="background: var(--white); height: 80px; resize: none;" required></textarea>
</div>
<div class="form-group">
<div style="display: flex; justify-content: space-between; align-items: center;">
<label class="form-label">Atur Pembobotan Nilai</label>
<span id="slider-label" style="font-size: 0.8rem; font-weight: bold; font-family: monospace; color: var(--muted);">50% Publik / 50% Juri</span>
</div>
<input type="hidden" id="weight_public" name="weight_public" value="50">
<input type="hidden" id="weight_jury" name="weight_jury" value="50">
<div class="slider-container">
<input type="range" min="0" max="100" value="50" class="form-input" style="padding:0; background:none; cursor:pointer;" oninput="updateWeights(this.value)">
</div>
<span style="font-size: 0.75rem; color: var(--muted); line-height: 1.3;">Geser untuk menentukan porsi pengaruh vote publik dibanding nilai angka murni dari juri.</span>
</div>
<div class="form-group">
<label class="form-label">Batas Waktu Penutupan (Deadline)</label>
<input type="datetime-local" name="deadline" class="form-input" style="background: var(--white);" required>
</div>
<button type="submit" class="btn btn-p" style="width: 100%; padding: 12px; margin-top: 8px;">Publish Sayembara</button>
</form>
</div>
</div>
</main>
</div>

<script>
function updateWeights(val) {
const publicWeight = parseInt(val);
const juryWeight = 100 - publicWeight;
document.getElementById('slider-label').innerText = `${publicWeight}% Publik / ${juryWeight}% Juri`;
document.getElementById('weight_public').value = publicWeight;
document.getElementById('weight_jury').value = juryWeight;
}
</script>
@end