@layouts.main({ title: 'Kelola ' + contest.title + ' — Admin KreasiHub' })

<nav class="navbar">
  <a href="/" class="logo">KreasiHub</a>
  <div class="nav-links">
    <a href="/admin/dashboard" class="nav-link active">← Dashboard</a>
  </div>
  <div class="nav-actions">
    <a href="/sayembara/{{ contest.id }}" class="btn btn-g" target="_blank">👁 Lihat Publik</a>
    <form action="/logout" method="POST" style="margin:0;">
      {{ csrfField() }}
      <button type="submit" class="btn btn-o">Logout</button>
    </form>
  </div>
</nav>

<div class="admin-layout" style="grid-template-columns:1fr;">
  <main class="admin-main">

    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:24px;">
      <div>
        <p class="card-cat" style="margin-bottom:8px;">Kelola Sayembara › Admin</p>
        <h1 class="form-title" style="font-size:2.4rem;">{{ contest.title }}</h1>
      </div>
      <div style="background:var(--surface);padding:12px 20px;border-radius:12px;border:1px solid var(--border);text-align:center;">
        <p style="font-size:0.75rem;color:var(--muted);text-transform:uppercase;font-weight:600;">Total Pendaftar</p>
        <p style="font-size:2rem;font-family:monospace;font-weight:bold;color:var(--primary);">{{ contest.submissions.length }}</p>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start;">

      <div>
        <h2 class="section-title" style="margin-bottom:16px;">Daftar Submission ({{ contest.submissions.length }})</h2>
        <div style="display:flex;flex-direction:column;gap:12px;">
          @each(sub in contest.submissions)
            <div class="card" style="flex-direction:row;min-height:110px;align-items:center;cursor:default;border-radius:12px;">
              <div style="width:110px;height:110px;flex-shrink:0;overflow:hidden;border-radius:12px 0 0 12px;background:var(--surface);position:relative;">
                <img src="{{ sub.imageUrl }}" alt="{{ sub.title }}" style="width:100%;height:100%;object-fit:cover;"
                     onerror="this.onerror=null; this.src='https://placehold.co/150x150/e2e8f0/475569?text=Link+Web/Drive';">
              </div>
              <div class="card-body" style="justify-content:center;gap:4px;padding:16px;flex:1;">
                <p class="card-cat" style="font-size:0.7rem;">Pembuat: {{ sub.participantName }}</p>
                <p class="card-title" style="font-size:1rem;font-weight:bold;margin-bottom:4px;">{{ sub.title }}</p>
                
                @if(sub.imageUrl)
                  <a href="{{ sub.imageUrl }}" target="_blank" style="font-size:0.8rem; color:var(--primary); text-decoration:underline; display:inline-block; margin-bottom:6px;">
                    🔗 Buka Tautan Karya Asli
                  </a>
                @endif

                <div style="display:flex;gap:10px;margin-top:4px;flex-wrap:wrap;">
                  <span style="font-size:0.8rem;background:var(--primary-light);color:var(--primary);padding:2px 10px;border-radius:999px;font-weight:600;">Skor: {{ sub.finalScore }}</span>
                  <span style="font-size:0.8rem;color:var(--muted);">♥ {{ sub.votes.filter(v => v.type === 'public').length }} publik</span>
                  <span style="font-size:0.8rem;color:var(--muted);">⭐ {{ sub.votes.filter(v => v.type === 'jury')[0]?.score || 0 }}/100 juri</span>
                </div>
              </div>
              <div style="padding:16px;flex-shrink:0;">
                <form action="/admin/submissions/{{ sub.id }}?_method=DELETE" method="POST"
                  onsubmit="return confirm('Yakin ingin mendiskualifikasi karya ini?')">
                  {{ csrfField() }}
                  <button type="submit" class="btn btn-danger" style="padding:6px 14px;font-size:0.75rem;">Diskualifikasi</button>
                </form>
              </div>
            </div>
          @else
            <div style="text-align:center;padding:40px 24px;background:var(--surface);border:1px dashed var(--border);border-radius:12px;color:var(--muted);">
              <div style="font-size:2.5rem;margin-bottom:12px;">📭</div>
              Belum ada karya yang diunggah.
            </div>
          @endeach
        </div>
      </div>

      <div style="background:var(--surface);padding:24px;border-radius:12px;border:1px solid var(--border);">
        <h2 class="section-title" style="margin-bottom:16px;">✏️ Edit Pengaturan Sayembara</h2>
        <form action="/admin/sayembaras/{{ contest.id }}/edit" method="POST" style="display:flex;flex-direction:column;gap:16px;">
          {{ csrfField() }}
          <div class="form-group">
            <label class="form-label">Nama Sayembara</label>
            <input type="text" name="title" value="{{ contest.title }}" class="form-input" style="background:var(--white);" required>
          </div>
          <div class="form-group">
            <label class="form-label">Kategori</label>
            <input type="text" name="category" value="{{ contest.category }}" class="form-input" style="background:var(--white);" required>
          </div>
          <div class="form-group">
            <label class="form-label">Link Banner/Gambar</label>
            <input type="url" name="image_url" value="{{ contest.imageUrl || '' }}" placeholder="https://images.unsplash.com/..." class="form-input" style="background:var(--white);">
          </div>
          <div class="form-group">
            <label class="form-label">Deskripsi & Aturan</label>
            <textarea name="description" class="form-input" style="background:var(--white);height:80px;resize:none;" required>{{ contest.description }}</textarea>
          </div>
          
          <div class="form-group">
            <label class="form-label">Tanggal & Waktu Penutupan (Deadline)</label>
            <input type="datetime-local" name="deadline" 
                   value="{{ contest.deadline ? contest.deadline.toFormat('yyyy-MM-dd\'T\'HH:mm') : '' }}" 
                   class="form-input" style="background:var(--white);" lang="id-ID" required>
            <span style="font-size:0.75rem;color:var(--muted);">Format waktu menggunakan sistem 24 jam.</span>
          </div>

          <div class="form-group">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <label class="form-label">Ubah Bobot <span style="color:#dc2626;font-size:0.8rem;">(Hati-hati!)</span></label>
              <span id="slider-label" style="font-size:0.8rem;font-weight:bold;font-family:monospace;color:var(--muted);">{{ contest.weightPublic }}% Publik / {{ contest.weightJury }}% Juri</span>
            </div>
            <input type="hidden" id="weight_public" name="weight_public" value="{{ contest.weightPublic }}">
            <input type="hidden" id="weight_jury" name="weight_jury" value="{{ contest.weightJury }}">
            <div class="slider-container">
              <input type="range" min="0" max="100" value="{{ contest.weightPublic }}" class="form-input" style="padding:0;background:none;cursor:pointer;" oninput="updateWeightsDetail(this.value)">
            </div>
          </div>
          <button type="submit" class="btn btn-p" style="width:100%;padding:12px;">💾 Simpan Perubahan</button>
        </form>

        <hr style="border:0;border-top:1px solid var(--border);margin:24px 0;">

        <h3 style="font-size:1rem;font-weight:600;color:var(--error);margin-bottom:12px;">⚠️ Zona Berbahaya</h3>
        <form action="/admin/sayembaras/{{ contest.id }}?_method=DELETE" method="POST"
          onsubmit="return confirm('HAPUS seluruh sayembara ini? Tindakan tidak bisa dibatalkan!')">
          {{ csrfField() }}
          <button type="submit" class="btn btn-danger" style="width:100%;padding:10px;">🗑 Hapus Sayembara Ini</button>
        </form>
      </div>

    </div>
  </main>
</div>

<script>
function updateWeightsDetail(val) {
  const p = parseInt(val), j = 100 - p
  document.getElementById('slider-label').innerText = `${p}% Publik / ${j}% Juri`
  document.getElementById('weight_public').value = p
  document.getElementById('weight_jury').value = j
}
</script>

@end