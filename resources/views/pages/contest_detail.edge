          <label class="form-label">Link Gambar / Website / Drive (URL)</label>
          <input type="url" name="image_url" placeholder="https://..." class="form-input" required>
          <span style="font-size:0.75rem;color:var(--muted);">Masukkan link gambar langsung, link prototype Figma, atau link website buatanmu.</span>
