        <h2 class="form-title" style="font-size:1.6rem;margin-bottom:8px;">Pengumpulan Ditutup</h2>
        <p style="font-size:0.95rem;color:var(--ink);">Masa pengumpulan karya telah resmi berakhir. Saatnya Vote Publik!</p>
      </div>
    @endif
  </div>
</div>

<script>
  async function handleVote(event, subId, form) {
    event.preventDefault()
    const btn = form.querySelector('button[type="submit"]')
    const csrfToken = form.querySelector('[name="_csrf"]').value
    
    btn.disabled = true
    btn.textContent = '⏳ Memproses...'
    
    try {
      const name = prompt('Masukkan nama kamu untuk mencatat vote (contoh: Nama Lengkap atau Inisial)')
      if (!name || !name.trim()) {
        btn.disabled = false
        btn.textContent = '♥ Vote Publik'
        if (window.showFlash) showFlash('Nama wajib diisi untuk melakukan vote.', 'destructive')
        else alert('Nama wajib diisi untuk melakukan vote.')
        return
      }

      const response = await fetch(`/submission/${subId}/vote-public`, {
        method: 'POST',
        headers: { 
          'X-Requested-With': 'XMLHttpRequest', 
          'X-CSRF-Token': csrfToken,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ voter_name: name.trim() })
      })
      
      if (response.ok) {
        btn.classList.add('voted')
        btn.textContent = '✅ Vote Terkirim!'
        if (window.showFlash) showFlash('Vote berhasil dikirim!', 'success')
        else alert('Vote berhasil dikirim!')
        setTimeout(() => window.location.reload(), 800)
      } else {
        const data = await response.json()
        btn.disabled = false
        btn.textContent = '♥ Vote Publik'
        if (window.showFlash) showFlash(data.message || 'Gagal mengirim vote.', 'destructive')
        else alert(data.message || 'Gagal mengirim vote.')
      }
    } catch (err) {
      btn.disabled = false
      btn.textContent = '♥ Vote Publik'
      if (window.showFlash) showFlash('Terjadi kesalahan jaringan.', 'destructive')
      else alert('Terjadi kesalahan jaringan.')
    }
  }
</script>

@end