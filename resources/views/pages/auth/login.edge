@layouts.main({ title: 'Login Admin — KreasiHub' })
<nav class="navbar">
<a href="/" class="logo">Sayembara</a>
<div class="nav-links">
<a href="/" class="nav-link">Jelajahi</a>
</div>
</nav>

<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh;">
  <div class="form-box" style="width: 100%; max-width: 400px; padding: 40px;">
    <h1 class="form-title" style="font-size: 2.2rem; margin-bottom: 8px; text-align: center;">Login Admin</h1>
    <p style="text-align: center; color: var(--muted); margin-bottom: 24px;">Silakan otentikasi untuk kelola sayembara.</p>

    <form action="/login" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
      {{ csrfField() }}
      
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-input" style="background: var(--white);" required>
      </div>

      <div class="form-group">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-input" style="background: var(--white);" required>
      </div>

      <button type="submit" class="btn btn-p" style="padding: 12px; margin-top: 16px;">Masuk</button>
    </form>
    <p style="text-align: center; margin-top: 24px; font-size: 0.9rem; color: var(--muted);">Belum punya akun? <a href="/signup" style="color: var(--primary); font-weight: 600; text-decoration: none;">Daftar di sini</a></p>
  </div>
</div>
@end
