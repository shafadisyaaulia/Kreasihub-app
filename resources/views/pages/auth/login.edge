@layouts.main({ title: 'Masuk — KreasiHub' })

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--white) 0%,var(--primary-light) 100%);padding:40px 20px;">
  <div style="width:100%;max-width:420px;">
    <div style="text-align:center;margin-bottom:32px;">
      <a href="/" class="logo" style="font-size:2.5rem;display:inline-block;margin-bottom:8px;">KreasiHub</a>
      <p style="color:var(--muted);font-size:0.95rem;">Masuk untuk memberikan vote dan kelola sayembara</p>
    </div>
    <div class="form-box" style="padding:36px;">
      <h1 style="font-size:1.6rem;font-weight:700;color:var(--black);margin-bottom:4px;">Selamat Datang</h1>
      <p style="color:var(--muted);margin-bottom:28px;font-size:0.9rem;">Masukkan email dan password akun kamu untuk melanjutkan.</p>

      <div style="background: var(--surface); border: 1px solid var(--border); padding: 12px; border-radius: 10px; margin-bottom: 18px; font-size: 0.88rem; color: var(--ink);">
        <div style="font-weight: 700; margin-bottom: 4px;">Akun Admin</div>
        <div style="color: var(--muted);">Email: <b>admin@kreasihub.com</b> · Password: <b>password123</b></div>
      </div>

      <form action="/login" method="POST" style="display:flex;flex-direction:column;gap:16px;">
        {{ csrfField() }}
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-input" placeholder="contoh@email.com" required>
        </div>
        <div class="form-group">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-input" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-p" style="padding:14px;margin-top:8px;font-size:1rem;width:100%;">
          Masuk ke Akun →
        </button>
      </form>
    </div>
    <p style="text-align:center;margin-top:24px;font-size:0.85rem;">
      <a href="/" style="color:var(--muted);text-decoration:none;">← Kembali ke halaman utama</a>
    </p>
  </div>
</div>

@end