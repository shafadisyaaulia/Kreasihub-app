<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title || 'KreasiHub — Platform Sayembara Kreatif' }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --black: #0f172a; --white: #ffffff; --ink: #334155; --muted: #64748b;
      --border: #e2e8f0; --surface: #f8fafc; --primary: #3b82f6;
      --primary-hover: #2563eb; --primary-light: #eff6ff; --primary-text: #1e40af;
      --bg: #f1f5f9; --success: #16a34a; --success-bg: #dcfce7;
      --success-border: #bbf7d0; --error: #dc2626; --error-bg: #fee2e2;
      --error-border: #fca5a5; --fd: 'Instrument Serif', Georgia, serif;
      --fb: 'DM Sans', system-ui, sans-serif; --r: 8px;
    }
    html { font-size: 15px; }
    body { background: var(--bg); font-family: var(--fb); display: flex; flex-direction: column; padding: 0; margin: 0; min-height: 100vh; color: var(--ink); }
    .browser { background: var(--white); width: 100%; overflow: hidden; display: flex; flex-direction: column; min-height: 100vh; }

    /* FLASH */
    .flash-wrap { position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; max-width: 380px; }
    .flash-msg { display: flex; align-items: flex-start; gap: 12px; padding: 14px 18px; border-radius: 12px; font-size: 0.9rem; font-weight: 500; box-shadow: 0 8px 24px rgba(0,0,0,0.12); animation: slideIn 0.3s ease; border: 1px solid; }
    .flash-msg.flash-success { background: var(--success-bg); border-color: var(--success-border); color: var(--success); }
    .flash-msg.flash-error { background: var(--error-bg); border-color: var(--error-border); color: var(--error); }
    .flash-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }
    .flash-close { margin-left: auto; background: none; border: none; cursor: pointer; font-size: 1rem; opacity: 0.6; padding: 0; color: inherit; }
    .flash-close:hover { opacity: 1; }
    @keyframes slideIn { from { transform: translateX(110%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @keyframes fadeOut { to { opacity: 0; transform: translateX(110%); } }

    /* NAVBAR */
    .navbar { display: flex; justify-content: space-between; align-items: center; padding: 18px 40px; border-bottom: 1px solid var(--border); background: var(--white); position: sticky; top: 0; z-index: 100; }
    .logo { font-family: var(--fd); font-size: 2rem; font-weight: bold; color: var(--primary); text-decoration: none; font-style: italic; }
    .nav-links { display: flex; gap: 32px; }
    .nav-link { font-size: 0.95rem; color: var(--muted); font-weight: 500; text-decoration: none; transition: color 0.2s; }
    .nav-link:hover { color: var(--primary); }
    .nav-link.active { color: var(--black); font-weight: 600; border-bottom: 2px solid var(--primary); padding-bottom: 4px; }
    .nav-actions { display: flex; gap: 12px; align-items: center; }

    /* BUTTONS */
    .btn { padding: 10px 20px; border-radius: var(--r); font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; border: 1px solid transparent; font-family: var(--fb); display: inline-flex; align-items: center; justify-content: center; text-decoration: none; gap: 6px; }
    .btn-p { background: var(--primary); color: var(--white); box-shadow: 0 4px 6px -1px rgba(59,130,246,0.3); }
    .btn-p:hover { background: var(--primary-hover); transform: translateY(-1px); }
    .btn-g { background: transparent; border-color: var(--border); color: var(--black); }
    .btn-g:hover { background: var(--surface); }
    .btn-o { background: transparent; border-color: var(--border); color: var(--muted); }
    .btn-o:hover { border-color: var(--primary); color: var(--primary); }
    .btn-danger { background: transparent; border-color: #fca5a5; color: #dc2626; }
    .btn-danger:hover { background: var(--error-bg); }

    /* HERO */
    .hero { padding: 80px 40px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; background: linear-gradient(135deg, var(--white) 0%, var(--primary-light) 100%); }
    .hero-label { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--primary-text); font-weight: 700; background: var(--white); padding: 6px 16px; border-radius: 999px; }
    .hero h1 { font-family: var(--fd); font-size: 5rem; line-height: 0.95; font-weight: 400; color: var(--black); }
    .hero h1 em { font-style: italic; color: var(--primary); }
    .hero p { font-size: 1.15rem; color: var(--ink); max-width: 540px; line-height: 1.6; }
    .hero-cta { display: flex; gap: 12px; margin-top: 8px; }

    /* CARDS */
    .cards-section { padding: 40px; background: var(--white); }
    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; border-bottom: 2px solid var(--surface); padding-bottom: 16px; }
    .section-title { font-size: 1.4rem; font-weight: 600; color: var(--black); }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
    .card { background: var(--white); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; cursor: pointer; transition: all 0.3s; display: flex; flex-direction: column; }
    .card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); }
    .card-img { height: 180px; background: var(--surface); display: flex; align-items: center; justify-content: center; position: relative; }
    .card-img img { width: 100%; height: 100%; object-fit: cover; }
    .card-body { padding: 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .card-cat { font-size: 0.8rem; text-transform: uppercase; color: var(--primary); font-weight: 700; letter-spacing: 0.05em; }
    .card-title { font-size: 1.25rem; font-weight: 600; color: var(--black); line-height: 1.3; }
    .card-desc { font-size: 0.95rem; color: var(--muted); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex: 1; }
    .card-meta { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--surface); padding-top: 16px; margin-top: 8px; }
    .card-meta-text { font-size: 0.85rem; }

    /* BADGES */
    .badge { padding: 6px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
    .badge-aktif { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .badge-selesai { background: #fef08a; color: #a16207; border: 1px solid #fde047; }

    /* DETAIL */
    .detail-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 40px; padding: 40px; background: var(--white); }
    .bento-info { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 32px; }
    .bento-card { background: var(--surface); border: 1px solid var(--border); padding: 20px; border-radius: 16px; display: flex; flex-direction: column; gap: 8px; transition: transform 0.2s; }
    .bento-card:hover { transform: translateY(-2px); }
    .bento-label { font-size: 0.8rem; color: var(--muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; }
    .bento-val { font-size: 1.6rem; font-weight: 600; color: var(--black); }
    .brief { font-size: 1.05rem; color: var(--ink); line-height: 1.6; display: flex; flex-direction: column; gap: 16px; }

    /* GALLERY */
    .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; margin-top: 24px; }
    .gal-item { background: var(--white); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; transition: all 0.2s; }
    .gal-item:hover { box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); transform: translateY(-2px); }
    .gal-img { height: 160px; background: var(--surface); position: relative; }
    .gal-img img { width: 100%; height: 100%; object-fit: cover; }
    .gal-body { padding: 16px; display: flex; flex-direction: column; gap: 10px; }
    .btn-vote { background: var(--white); border: 1px solid var(--border); padding: 8px 16px; border-radius: 999px; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s; color: var(--muted); }
    .btn-vote:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-light); }
    .btn-vote.voted { background: var(--primary); border-color: var(--primary); color: var(--white); }

    /* FORMS */
    .form-box { padding: 40px; background: var(--surface); display: flex; flex-direction: column; gap: 32px; border-radius: 16px; border: 1px solid var(--border); }
    .form-title { font-family: var(--fd); font-size: 2.6rem; font-weight: 400; color: var(--primary); }
    .form-group { display: flex; flex-direction: column; gap: 8px; }
    .form-label { font-size: 0.95rem; color: var(--ink); font-weight: 600; }
    .form-input { padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border); background: var(--white); font-family: var(--fb); font-size: 1rem; color: var(--black); outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
    .form-input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-light); }

    /* ADMIN */
    .admin-layout { display: grid; grid-template-columns: 240px 1fr; min-height: calc(100vh - 73px); background: var(--white); }
    .sidebar { background: var(--surface); border-right: 1px solid var(--border); padding: 32px 20px; display: flex; flex-direction: column; gap: 12px; }
    .side-item { padding: 12px 16px; border-radius: 8px; font-size: 0.95rem; color: var(--muted); font-weight: 500; transition: all 0.2s; text-decoration: none; display: block; }
    .side-item:hover { background: var(--white); color: var(--ink); }
    .side-item.active { background: var(--primary); color: var(--white); font-weight: 600; }
    .admin-main { padding: 40px; }

    /* TABLE */
    .table-container { width: 100%; overflow-x: auto; margin-top: 24px; border: 1px solid var(--border); border-radius: 12px; }
    .table { width: 100%; border-collapse: separate; border-spacing: 0; text-align: left; font-size: 0.95rem; background: var(--white); }
    .table th { background: var(--surface); padding: 16px 20px; color: var(--ink); font-weight: 600; border-bottom: 2px solid var(--border); text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em; }
    .table td { padding: 16px 20px; border-bottom: 1px solid var(--border); color: var(--muted); }
    .table tr:last-child td { border-bottom: 0; }
    .table tr:hover td { background: var(--primary-light); color: var(--black); }

    /* FOOTER */
    .footer { background: var(--black); color: rgba(255,255,255,0.5); padding: 32px 40px; text-align: center; font-size: 0.85rem; margin-top: auto; }
    .footer a { color: rgba(255,255,255,0.7); text-decoration: none; }

    .slider-container { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
  </style>
</head>
<body>

  <div class="flash-wrap" id="flashWrap">
    @if(flashMessages.has('success'))
      <div class="flash-msg flash-success" id="flash-success">
        <span class="flash-icon">✅</span>
        <span>{{ flashMessages.get('success') }}</span>
        <button class="flash-close" onclick="dismissFlash('flash-success')">✕</button>
      </div>
    @endif
    @if(flashMessages.has('error'))
      <div class="flash-msg flash-error" id="flash-error">
        <span class="flash-icon">❌</span>
        <span>{{ flashMessages.get('error') }}</span>
        <button class="flash-close" onclick="dismissFlash('flash-error')">✕</button>
      </div>
    @endif
  </div>

  <div class="browser">
    {{{ await $slots.main() }}}

    <footer class="footer">
      <p>© 2026 <strong style="color: rgba(255,255,255,0.85);">KreasiHub</strong> — Platform Sayembara Kreatif &nbsp;·&nbsp; Dibuat oleh <strong style="color: rgba(255,255,255,0.9);">Shafa Disya Aulia</strong></p>
    </footer>
  </div>

  <script>
    function dismissFlash(id) {
      const el = document.getElementById(id)
      if (el) {
        el.style.animation = 'fadeOut 0.3s ease forwards'
        setTimeout(() => el.remove(), 300)
      }
    }
    setTimeout(() => {
      ['flash-success', 'flash-error'].forEach(id => {
        const el = document.getElementById(id)
        if (el) {
          el.style.animation = 'fadeOut 0.3s ease forwards'
          setTimeout(() => el.remove(), 300)
        }
      })
    }, 5000)
  </script>

</body>
</html>